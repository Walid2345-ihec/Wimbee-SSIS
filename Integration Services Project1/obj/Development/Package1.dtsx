                  exclusionGroup="1"
                  name="Sortie d'attribut fixe"
                  synchronousInputId="Package\Tâche de flux de données\Dimension à variation lente.Inputs[Entrée de dimension à variation lente]">
                  <externalMetadataColumns />
                </output>
                <output
                  refId="Package\Tâche de flux de données\Dimension à variation lente.Outputs[Sortie de mises à jour d'attribut de validation]"
                  description="Ces lignes contiennent de nouvelles informations sur les modifications de colonnes ChangingAttribute (type 1)"
                  exclusionGroup="1"
                  name="Sortie de mises à jour d'attribut de validation"
                  synchronousInputId="Package\Tâche de flux de données\Dimension à variation lente.Inputs[Entrée de dimension à variation lente]">
                  <externalMetadataColumns />
                </output>
                <output
                  refId="Package\Tâche de flux de données\Dimension à variation lente.Outputs[Sortie d'insertions d'attribut d'historique]"
                  description="Les modifications sur HistoricalAttribute (type 2) apparaissent dans ces nouvelles lignes"
                  exclusionGroup="2"
                  name="Sortie d'insertions d'attribut d'historique"
                  synchronousInputId="Package\Tâche de flux de données\Dimension à variation lente.Inputs[Entrée de dimension à variation lente]">
                  <externalMetadataColumns />
                </output>
                <output
                  refId="Package\Tâche de flux de données\Dimension à variation lente.Outputs[Sortie de mises à jour de membre déduit]"
                  description="Information de mise à jour de ligne de dimension initiale non remplie"
                  exclusionGroup="1"
                  name="Sortie de mises à jour de membre déduit"
                  synchronousInputId="Package\Tâche de flux de données\Dimension à variation lente.Inputs[Entrée de dimension à variation lente]">
                  <externalMetadataColumns />
                </output>
              </outputs>
